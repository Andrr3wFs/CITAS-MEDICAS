# ==========================================
# CONFIGURACIÓN DEL SERVIDOR Y SEGURIDAD
# ==========================================
PORT=5000
NODE_ENV=production
JWT_SECRET=<secreto_aleatorio_de_al_menos_32_caracteres>
MFA_ENCRYPTION_KEY=<secreto_aleatorio_distinto_para_cifrar_totp>
MFA_ISSUER=MediCenter

# Una instalación vacía no crea cuentas inseguras. Configura el administrador inicial
# con una contraseña de 12+ caracteres, mayúscula, minúscula, número y símbolo.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=Administrador inicial
BOOTSTRAP_ADMIN_PASSWORD=<contraseña_unica_que_no_contenga_admin>

# Milisegundos. Las sesiones se invalidan en el servidor al superar estos límites.
SESSION_IDLE_TIMEOUT_MS=900000
SESSION_ABSOLUTE_TIMEOUT_MS=28800000
AUTH_CHALLENGE_TIMEOUT_MS=300000

# ==========================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASSWORD=tu-app-password

# ==========================================
# URLS DEL SISTEMA Y ENLACES
# ==========================================
ADMIN_DASHBOARD_URL=https://medicenters.uk
LOGIN_URL=https://medicenters.uk