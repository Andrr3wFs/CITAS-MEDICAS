# Server security
NODE_ENV=production
JWT_SECRET=<secreto_aleatorio_de_al_menos_32_caracteres>
MFA_ENCRYPTION_KEY=<secreto_aleatorio_distinto_para_cifrar_totp>
MFA_ISSUER=MediCenter
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=Administrador inicial
BOOTSTRAP_ADMIN_PASSWORD=<contraseña_unica_que_no_contenga_admin>
SESSION_IDLE_TIMEOUT_MS=900000
SESSION_ABSOLUTE_TIMEOUT_MS=28800000
AUTH_CHALLENGE_TIMEOUT_MS=300000

# Email Configuration for Access Notifications
# These variables are used by the email service to send notifications

# Email service provider
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Gmail or email service credentials
# For Gmail, use an App Password (not your regular password)
# Learn more: https://support.google.com/accounts/answer/185833
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# URLs for email links
ADMIN_DASHBOARD_URL=http://localhost:3000
LOGIN_URL=http://localhost:3000

# You can also use other services like SendGrid, Mailgun, etc.
# Just update the EMAIL_HOST and credentials accordingly
